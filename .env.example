# Existing — Telegram order notifications (app/api/order/route.ts).
# Optional in dev: if unset, orders are logged to the server console instead
# of sent (see src/lib/telegram.ts's simulated-mode fallback).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# P14 foundation — Coffee Passport architecture (Supabase).
# NOT YET CONNECTED: there is no live Supabase project for this repository.
# Nothing in the current D2C site (catalog, cart, checkout, Coffee Passport)
# reads these — they only exist for the new, unwired scaffolding in
# src/lib/supabase/. See P14_COFFEE_PASSPORT_ARCHITECTURE_FOUNDATION.md for
# what creating a real project and filling these in would unlock.
#
# NEXT_PUBLIC_* because these are the anon/publishable key, safe for the
# browser by Supabase's own design — RLS is what actually protects data, not
# keeping this key secret. Never put a service-role key behind a
# NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# P24 — Coffee Passport integration client (src/lib/integrations/coffeePassportClient.ts).
# SERVER-ONLY — deliberately NOT NEXT_PUBLIC_*. Never read outside a server
# context (route handler, server action, server component) and never passed
# to a client component as a prop.
#
# COFFEE_PASSPORT_INTEGRATION_URL is the full URL of Coffee Passport's P23
# read-only endpoint (GET .../api/integrations/xo-store/lots) — not a base
# origin, since this client calls exactly one endpoint and there is no
# confirmed need yet for a second one.
#
# COFFEE_PASSPORT_INTEGRATION_SECRET is this Store's copy of the shared
# bearer secret P23 validates on its side (Coffee Passport's own env var for
# it is named XO_STORE_INTEGRATION_SECRET — same value, different name,
# because each repo names its env vars from its own point of view, same
# convention already used for TELEGRAM_BOT_TOKEN/TELEGRAM_CHAT_ID above).
# Sent as `Authorization: Bearer <value>` — never as a query string.
#
# Unset in dev: fetchXoRoasterLots() returns a `not_configured` error instead
# of throwing or guessing a URL — same fail-loud convention as
# src/lib/supabase/client.ts and server.ts.
COFFEE_PASSPORT_INTEGRATION_URL=
COFFEE_PASSPORT_INTEGRATION_SECRET=

# Store catalog source — Admin Panel's published products
# (src/lib/integrations/adminStoreClient.ts, src/lib/store/catalog.ts).
# Production catalog = Admin Panel -> GET /api/integrations/xo-store/products.
# There is no shared database and no Store-side copy of Admin's products.
#
# SERVER-ONLY — deliberately NOT NEXT_PUBLIC_*; read only during server
# rendering (app/layout.tsx) and never passed to a client component. Same
# naming convention as COFFEE_PASSPORT_INTEGRATION_* above: this repo names
# the variable after the provider it calls.
#
# ADMIN_INTEGRATION_URL is the FULL endpoint URL, e.g.
#   https://<admin-deployment-host>/api/integrations/xo-store/products
# (the Admin deployment URL is not recorded anywhere in this repo — set it
# per environment; do not guess it).
#
# ADMIN_INTEGRATION_SECRET is this Store's copy of the bearer secret Admin
# validates. It must equal the value of the Admin app's own env var
# STORE_INTEGRATION_SECRET (same value, different name). Sent as
# `Authorization: Bearer <value>`, never in a query string.
#
# If unset in local development, the storefront serves the DEV-ONLY static
# demo catalog (src/data/lots.json). If unset in production, or if Admin
# answers 401/403/5xx/malformed, the catalog shows an "unavailable" state —
# there is never a silent fallback to another catalog in production.
# Freshness: an Admin response is reused for 30s (ADMIN_CATALOG_REVALIDATE_SECONDS),
# so publishing/unpublishing in Admin reaches the Store without a redeploy.
ADMIN_INTEGRATION_URL=
ADMIN_INTEGRATION_SECRET=

# Checkout -> Admin orders (app/api/order/route.ts, adminStoreClient.ts).
# No new variable: the orders endpoint is derived from ADMIN_INTEGRATION_URL by
# swapping its trailing `/products` for `/orders`
# (POST <admin>/api/integrations/xo-store/orders), with the same
# ADMIN_INTEGRATION_SECRET as Bearer. So ADMIN_INTEGRATION_URL must keep
# ending in `/products`; anything else is treated as not configured.
# The order body is only { customer_name, customer_contact,
# items: [{ variant_id, quantity }] } — Admin prices it and decides
# from_stock / to_produce. If Admin is unreachable or refuses, checkout fails
# and the cart is kept.
