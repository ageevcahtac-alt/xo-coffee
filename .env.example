# Existing — Telegram order notifications (app/api/order/route.ts).
# Optional in dev: if unset, orders are logged to the server console instead
# of sent (see src/lib/telegram.ts's simulated-mode fallback).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# P14 foundation — Coffee Passport architecture (Supabase).
# NOT YET CONNECTED: there is no live Supabase project for this repository.
# Nothing in the current D2C site (catalog, cart, checkout, Coffee Passport)
# reads these — they only exist for the new, unwired scaffolding in
# src/lib/supabase/. See P14_COFFEE_PASSPORT_ARCHITECTURE_FOUNDATION.md for
# what creating a real project and filling these in would unlock.
#
# NEXT_PUBLIC_* because these are the anon/publishable key, safe for the
# browser by Supabase's own design — RLS is what actually protects data, not
# keeping this key secret. Never put a service-role key behind a
# NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
