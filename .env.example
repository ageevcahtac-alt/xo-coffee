# Existing — Telegram order notifications (app/api/order/route.ts).
# Optional in dev: if unset, orders are logged to the server console instead
# of sent (see src/lib/telegram.ts's simulated-mode fallback).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# P14 foundation — Coffee Passport architecture (Supabase).
# NOT YET CONNECTED: there is no live Supabase project for this repository.
# Nothing in the current D2C site (catalog, cart, checkout, Coffee Passport)
# reads these — they only exist for the new, unwired scaffolding in
# src/lib/supabase/. See P14_COFFEE_PASSPORT_ARCHITECTURE_FOUNDATION.md for
# what creating a real project and filling these in would unlock.
#
# NEXT_PUBLIC_* because these are the anon/publishable key, safe for the
# browser by Supabase's own design — RLS is what actually protects data, not
# keeping this key secret. Never put a service-role key behind a
# NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# P24 — Coffee Passport integration client (src/lib/integrations/coffeePassportClient.ts).
# SERVER-ONLY — deliberately NOT NEXT_PUBLIC_*. Never read outside a server
# context (route handler, server action, server component) and never passed
# to a client component as a prop.
#
# COFFEE_PASSPORT_INTEGRATION_URL is the full URL of Coffee Passport's P23
# read-only endpoint (GET .../api/integrations/xo-store/lots) — not a base
# origin, since this client calls exactly one endpoint and there is no
# confirmed need yet for a second one.
#
# COFFEE_PASSPORT_INTEGRATION_SECRET is this Store's copy of the shared
# bearer secret P23 validates on its side (Coffee Passport's own env var for
# it is named XO_STORE_INTEGRATION_SECRET — same value, different name,
# because each repo names its env vars from its own point of view, same
# convention already used for TELEGRAM_BOT_TOKEN/TELEGRAM_CHAT_ID above).
# Sent as `Authorization: Bearer <value>` — never as a query string.
#
# Unset in dev: fetchXoRoasterLots() returns a `not_configured` error instead
# of throwing or guessing a URL — same fail-loud convention as
# src/lib/supabase/client.ts and server.ts.
COFFEE_PASSPORT_INTEGRATION_URL=
COFFEE_PASSPORT_INTEGRATION_SECRET=
